public class DeliveryRouteOptimizerGUI extends JFrame 
{

    // --- CONSTANTS ---
    private static final int DEPOT = 0;
    private static final double DIESEL_PRICE = 88.34;
    private static final double KM_PER_LITER = 10.0;

    private static final String[] PLACES = {
        "Depot (Clock Tower)",
        "Pacific Mall",
        "Paltan Bazaar",
        "Miyawala",
        "Sahastradhara",
        "Rajpur Road",
        "FRI"
    };

    // --- DATA STRUCTURES ---
    static class Edge {
        int to;
        double weight;

        Edge(int t, double w) {
            to = t;
            weight = w;
        }
    }

    private static final List<List<Edge>> adjList = new ArrayList<>();

    static {
        for (int i = 0; i < PLACES.length; i++) {
            adjList.add(new ArrayList<>());
        }

        double[][] d = {
            {0, 4.8, 2.1, 8.5, 14.2, 9.7, 6.3},
            {4.8, 0, 3.5, 11.2, 16.8, 12.4, 8.9},
            {2.1, 3.5, 0, 7.9, 13.5, 8.1, 5.2},
            {8.5, 11.2, 7.9, 0, 9.4, 6.8, 11.7},
            {14.2, 16.8, 13.5, 9.4, 0, 12.3, 15.6},
            {9.7, 12.4, 8.1, 6.8, 12.3, 0, 9.1},
            {6.3, 8.9, 5.2, 11.7, 15.6, 9.1, 0}
        };

        for (int i = 0; i < d.length; i++) {
            for (int j = 0; j < d.length; j++) {
                if (i != j) {
                    adjList.get(i).add(new Edge(j, d[i][j]));
                }
            }
        }
    }

    private JTextArea outputArea;

