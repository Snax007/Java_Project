import javax.swing.*;
import java.awt.*;
import java.awt.geom.Ellipse2D;
import java.util.*;
import java.util.List;

public class DeliveryRouteOptimizerGUI extends JFrame {

    // --- Configuration Constants ---
    private static final int DEPOT = 0;
    private static final double DIESEL_PRICE = 88.34;
    private static final double KM_PER_LITER = 10.0;
    
    public static final String[] PLACES = {
        "Depot (Clock Tower)", "Pacific Mall", "Paltan Bazaar", 
        "Miyawala", "Sahastradhara", "Rajpur Road", "Forest Research Institute (FRI)"
    };

    // Raw Adjacency for Dijkstra to process
    private static final double[][] RAW_ADJACENCY = {
        {0.0, 4.8, 2.1, 8.5, 14.2, 9.7, 6.3},
        {4.8, 0.0, 3.5, 11.2, 16.8, 12.4, 8.9},
        {2.1, 3.5, 0.0, 7.9, 13.5, 8.1, 5.2},
        {8.5, 11.2, 7.9, 0.0, 9.4, 6.8, 11.7},
        {14.2, 16.8, 13.5, 9.4, 0.0, 12.3, 15.6},
        {9.7, 12.4, 8.1, 6.8, 12.3, 0.0, 9.1},
        {6.3, 8.9, 5.2, 11.7, 15.6, 9.1, 0.0}
    };

    private JTextArea outputArea;
    private List<Integer> bestRoute;
    private double minDistance;

    public DeliveryRouteOptimizerGUI() {
        setTitle("RouteOpti - Navigation & TSP Solver");
        setSize(1100, 800);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(10, 10));

        // Header
        JLabel header = new JLabel("🚚 RouteOpti - Step-by-Step Delivery Optimizer", SwingConstants.CENTER);
        header.setFont(new Font("Segoe UI", Font.BOLD, 28));
        header.setBackground(new Color(25, 55, 150));
        header.setForeground(Color.WHITE);
        header.setOpaque(true);
        header.setPreferredSize(new Dimension(0, 90));
        add(header, BorderLayout.NORTH);

        // Output Area
        outputArea = new JTextArea();
        outputArea.setFont(new Font("Consolas", Font.PLAIN, 15));
        outputArea.setEditable(false);
        outputArea.setMargin(new Insets(20, 20, 20, 20));
        add(new JScrollPane(outputArea), BorderLayout.CENTER);

        // Buttons (Same UI features)
        JPanel buttonPanel = new JPanel(new GridLayout(1, 4, 15, 15));
        buttonPanel.setBorder(BorderFactory.createEmptyBorder(25, 25, 25, 25));

        JButton btnAdj = createStyledButton("📊 Adjacency List", new Color(52, 152, 219));
        JButton btnOptimize = createStyledButton("🚚 Solve TSP", new Color(46, 204, 113));
        JButton btnDijkstra = createStyledButton("📍 Dijkstra", new Color(155, 89, 182));
        JButton btnGraph = createStyledButton("🌐 View Graph", new Color(231, 76, 60));

        btnAdj.addActionListener(e -> showAdjacencyList());
        btnOptimize.addActionListener(e -> solveTSP());
        btnDijkstra.addActionListener(e -> showDijkstraPanel());
        btnGraph.addActionListener(e -> new GraphVisualization().setVisible(true));

        buttonPanel.add(btnAdj);
        buttonPanel.add(btnOptimize);
        buttonPanel.add(btnDijkstra);
        buttonPanel.add(btnGraph);
        add(buttonPanel, BorderLayout.SOUTH);

        outputArea.setText("✅ System Ready.\nExact Route Search is active.\nSelect 'Solve TSP' to begin.");
    }

    private JButton createStyledButton(String text, Color color) {
        JButton btn = new JButton(text);
        btn.setFont(new Font("Segoe UI", Font.BOLD, 15));
        btn.setBackground(color);
        btn.setForeground(Color.WHITE);
        btn.setFocusPainted(false);
        btn.setBorder(BorderFactory.createEmptyBorder(15, 10, 15, 10));
        return btn;
    }

    private void solveTSP() {
        // Selection Dialog
        JPanel panel = new JPanel(new GridLayout(0, 1));
        JCheckBox[] boxes = new JCheckBox[PLACES.length - 1];
        for (int i = 1; i < PLACES.length; i++) {
            boxes[i-1] = new JCheckBox(PLACES[i], true);
            panel.add(boxes[i-1]);
        }

        if (JOptionPane.showConfirmDialog(this, panel, "Select Deliveries", JOptionPane.OK_CANCEL_OPTION) != JOptionPane.OK_OPTION) return;

        List<Integer> selected = new ArrayList<>();
        for (int i = 0; i < boxes.length; i++) if (boxes[i].isSelected()) selected.add(i + 1);
        if (selected.isEmpty()) return;

        // 1. Build Distance Matrix via Dijkstra
        double[][] fullMatrix = new double[PLACES.length][PLACES.length];
        for (int i = 0; i < PLACES.length; i++) {
            for (int j = 0; j < PLACES.length; j++) {
                fullMatrix[i][j] = (i == j) ? 0 : dijkstraDistance(i, j);
            }
        }

        // 2. Calculate Naive (Original Order)
        List<Integer> naive = new ArrayList<>();
        naive.add(DEPOT);
        naive.addAll(selected);
        naive.add(DEPOT);
        double naiveDist = calculateTotalDistance(naive, fullMatrix);

        // 3. Perfect TSP Search (Permutations)
        minDistance = Double.MAX_VALUE;
        bestRoute = new ArrayList<>();
        permute(selected, 0, selected.size() - 1, fullMatrix);

        // 4. Generate Step-by-Step Instructions
        double savedKm = naiveDist - minDistance;
        double savedMoney = (savedKm / KM_PER_LITER) * DIESEL_PRICE;

        StringBuilder sb = new StringBuilder("=== 🚚 OPTIMIZED DELIVERY PLAN ===\n\n");
        sb.append(String.format("Distance: %.2f km (Saved %.2f km)\n", minDistance, Math.max(0, savedKm)));
        sb.append(String.format("Savings:  ₹ %.0f\n", Math.max(0, savedMoney)));
        sb.append("--------------------------------------------------\n");
        sb.append("NAVIGATION LOG:\n");

        for (int i = 0; i < bestRoute.size() - 1; i++) {
            int fromIdx = bestRoute.get(i);
            int toIdx = bestRoute.get(i + 1);
            double legDist = fullMatrix[fromIdx][toIdx];
            
            String action = (i == 0) ? "START AT " : "THEN GO TO ";
            if (i == bestRoute.size() - 2) {
                sb.append(String.format("Step %d: %s %-25s -> RETURN TO DEPOT (%.1f km)\n", 
                        (i + 1), action, PLACES[fromIdx], legDist));
            } else {
                sb.append(String.format("Step %d: %s %-25s -> Next: %-15s (%.1f km)\n", 
                        (i + 1), action, PLACES[fromIdx], PLACES[toIdx], legDist));
            }
        }
        sb.append("--------------------------------------------------\n");
        sb.append("Goal Reached: All deliveries completed efficiently.");

        outputArea.setText(sb.toString());
    }

    private void permute(List<Integer> list, int l, int r, double[][] matrix) {
        if (l == r) {
            List<Integer> current = new ArrayList<>();
            current.add(DEPOT);
            current.addAll(list);
            current.add(DEPOT);
            double d = calculateTotalDistance(current, matrix);
            if (d < minDistance) {
                minDistance = d;
                bestRoute = new ArrayList<>(current);
            }
        } else {
            for (int i = l; i <= r; i++) {
                Collections.swap(list, l, i);
                permute(list, l + 1, r, matrix);
                Collections.swap(list, l, i);
            }
        }
    }

    private double calculateTotalDistance(List<Integer> route, double[][] matrix) {
        double total = 0;
        for (int i = 0; i < route.size() - 1; i++) total += matrix[route.get(i)][route.get(i+1)];
        return total;
    }

    private double dijkstraDistance(int start, int target) {
        int n = PLACES.length;
        double[] dist = new double[n];
        boolean[] visited = new boolean[n];
        Arrays.fill(dist, Double.MAX_VALUE);
        dist[start] = 0;
        for (int i = 0; i < n - 1; i++) {
            int u = -1;
            double min = Double.MAX_VALUE;
            for (int v = 0; v < n; v++) if (!visited[v] && dist[v] < min) { min = dist[v]; u = v; }
            if (u == -1) break;
            visited[u] = true;
            for (int v = 0; v < n; v++) {
                if (!visited[v] && RAW_ADJACENCY[u][v] != 0 && dist[u] + RAW_ADJACENCY[u][v] < dist[v]) {
                    dist[v] = dist[u] + RAW_ADJACENCY[u][v];
                }
            }
        }
        return dist[target];
    }

    private void showAdjacencyList() {
        StringBuilder sb = new StringBuilder("📊 NETWORK MAP (Distances)\n\n");
        for (int i = 0; i < PLACES.length; i++) {
            sb.append(String.format("%-25s: ", PLACES[i]));
            for (int j = 0; j < PLACES.length; j++) {
                if (RAW_ADJACENCY[i][j] > 0) sb.append(PLACES[j]).append("(").append(RAW_ADJACENCY[i][j]).append("km) ");
            }
            sb.append("\n");
        }
        outputArea.setText(sb.toString());
    }

    private void showDijkstraPanel() {
        String[] opts = new String[PLACES.length - 1];
        for (int i = 1; i < PLACES.length; i++) opts[i-1] = PLACES[i];
        String pick = (String) JOptionPane.showInputDialog(this, "Target:", "Dijkstra Search", JOptionPane.PLAIN_MESSAGE, null, opts, opts[0]);
        if (pick == null) return;
        int target = 0;
        for (int i = 0; i < PLACES.length; i++) if (PLACES[i].equals(pick)) target = i;
        outputArea.setText("Direct Dijkstra Result:\nDepot to " + pick + "\nTotal: " + dijkstraDistance(DEPOT, target) + " km");
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new DeliveryRouteOptimizerGUI().setVisible(true));
    }
}

class GraphVisualization extends JFrame {
    public GraphVisualization() {
        setTitle("Visual Network Graph");
        setSize(900, 700);
        setLocationRelativeTo(null);
        add(new GraphPanel());
    }

    static class GraphPanel extends JPanel {
        private final Map<String, Point> coords = new HashMap<>();
        public GraphPanel() {
            setBackground(new Color(245, 245, 245));
            coords.put(DeliveryRouteOptimizerGUI.PLACES[0], new Point(450, 320));
            coords.put(DeliveryRouteOptimizerGUI.PLACES[1], new Point(450, 100));
            coords.put(DeliveryRouteOptimizerGUI.PLACES[2], new Point(350, 480));
            coords.put(DeliveryRouteOptimizerGUI.PLACES[3], new Point(750, 520));
            coords.put(DeliveryRouteOptimizerGUI.PLACES[4], new Point(780, 150));
            coords.put(DeliveryRouteOptimizerGUI.PLACES[5], new Point(620, 250));
            coords.put(DeliveryRouteOptimizerGUI.PLACES[6], new Point(120, 300));
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            String[] places = DeliveryRouteOptimizerGUI.PLACES;
            double[][] data = {{0,4.8,2.1,8.5,14.2,9.7,6.3},{4.8,0,3.5,11.2,16.8,12.4,8.9},{2.1,3.5,0,7.9,13.5,8.1,5.2},{8.5,11.2,7.9,0,9.4,6.8,11.7},{14.2,16.8,13.5,9.4,0,12.3,15.6},{9.7,12.4,8.1,6.8,12.3,0,9.1},{6.3,8.9,5.2,11.7,15.6,9.1,0}};

            for (int i = 0; i < places.length; i++) {
                for (int j = i + 1; j < places.length; j++) {
                    Point p1 = coords.get(places[i]), p2 = coords.get(places[j]);
                    g2d.setColor(new Color(220, 220, 220));
                    g2d.drawLine(p1.x, p1.y, p2.x, p2.y);
                    g2d.setColor(Color.GRAY);
                    g2d.setFont(new Font("Arial", Font.PLAIN, 10));
                    g2d.drawString(data[i][j] + "km", (p1.x + p2.x)/2, (p1.y + p2.y)/2);
                }
            }
            for (String n : places) {
                Point p = coords.get(n);
                g2d.setColor(n.contains("Depot") ? new Color(231, 76, 60) : new Color(41, 128, 185));
                g2d.fill(new Ellipse2D.Double(p.x-10, p.y-10, 20, 20));
                g2d.setColor(Color.BLACK);
                g2d.drawString(n, p.x+12, p.y+5);
            }
        }
    }
}
