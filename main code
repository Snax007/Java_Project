    // Inner class for drawing the graph
    class GraphPanel extends JPanel {
        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();
            int centerX = width / 2;
            int centerY = height / 2;
            int radius = Math.min(width, height) / 2 - 100;

            int n = PLACES.length;
            int[] x = new int[n];
            int[] y = new int[n];

            // Calculate node positions in a circle
            for (int i = 0; i < n; i++) {
                double angle = 2 * Math.PI * i / n - Math.PI / 2;
                x[i] = centerX + (int) (radius * Math.cos(angle));
                y[i] = centerY + (int) (radius * Math.sin(angle));
            }

            // Draw Edges with distances
            g2.setColor(new Color(180, 180, 180));
            g2.setStroke(new BasicStroke(3));
            for (int i = 0; i < n; i++) {
                for (Edge e : adjList.get(i)) {
                    if (i < e.to) {  // draw each edge only once
                        g2.drawLine(x[i], y[i], x[e.to], y[e.to]);

                        // Draw distance label
                        int midX = (x[i] + x[e.to]) / 2;
                        int midY = (y[i] + y[e.to]) / 2;
                        g2.setColor(Color.BLACK);
                        g2.setFont(new Font("Arial", Font.BOLD, 12));
                        g2.drawString(e.weight + " km", midX - 15, midY - 5);
                        g2.setColor(new Color(180, 180, 180));
                    }
                }
            }

            // Draw Nodes
            for (int i = 0; i < n; i++) {
                if (i == DEPOT) {
                    g2.setColor(new Color(220, 50, 50)); // Red for Depot
                } else {
                    g2.setColor(new Color(50, 130, 220)); // Blue for others
                }
                g2.fillOval(x[i] - 22, y[i] - 22, 44, 44);

                g2.setColor(Color.WHITE);
                g2.setFont(new Font("Arial", Font.BOLD, 12));
                String name = PLACES[i];
                if (name.length() > 12) name = name.substring(0, 12) + "..";
                int strWidth = g2.getFontMetrics().stringWidth(name);
                g2.drawString(name, x[i] - strWidth / 2, y[i] + 6);
            }
        }
    }

    // ====================== SOLVE WITH ACO ======================
    private void solveWithACO() {
        JPanel panel = new JPanel(new GridLayout(PLACES.length - 1, 1, 5, 5));
        checkBoxes = new JCheckBox[PLACES.length - 1];

        for (int i = 1; i < PLACES.length; i++) {
            checkBoxes[i-1] = new JCheckBox(PLACES[i]);
            checkBoxes[i-1].setSelected(true);
            panel.add(checkBoxes[i-1]);
        }

        int result = JOptionPane.showConfirmDialog(this, panel, "Select Delivery Locations", JOptionPane.OK_CANCEL_OPTION);
        if (result != JOptionPane.OK_OPTION) return;

        List<Integer> selected = new ArrayList<>();
        for (int i = 0; i < checkBoxes.length; i++) {
            if (checkBoxes[i].isSelected()) selected.add(i + 1);
        }

        if (selected.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please select at least one location!");
            return;
        }

        double[][] distMatrix = new double[PLACES.length][PLACES.length];
        for (int i = 0; i < PLACES.length; i++) {
            for (int j = 0; j < PLACES.length; j++) {
                distMatrix[i][j] = (i == j) ? 0 : dijkstraDistance(i, j);
            }
        }

        List<Integer> acoRoute = runACO(selected, distMatrix);
        double acoDist = calculateTotalDistance(acoRoute, distMatrix);

        StringBuilder routeStr = new StringBuilder("=== ACO OPTIMIZED ROUTE ===\n\n");
        for (int loc : acoRoute) {
            routeStr.append(PLACES[loc]).append(" → ");
        }
        routeStr.setLength(routeStr.length() - 3);

        outputArea.setText(routeStr.toString() + "\n\nTotal Distance : " + String.format("%.1f", acoDist) + " km\n" +
                "Fuel Used      : " + String.format("%.2f", acoDist / KM_PER_LITER) + " L\n" +
                "Estimated Cost : ₹ " + Math.round((acoDist / KM_PER_LITER) * DIESEL_PRICE));
    }

    // ====================== COMPARE ACO vs PSO ======================
    private void compareAlgorithms() {
        JPanel panel = new JPanel(new GridLayout(PLACES.length - 1, 1, 5, 5));
        checkBoxes = new JCheckBox[PLACES.length - 1];

        for (int i = 1; i < PLACES.length; i++) {
            checkBoxes[i-1] = new JCheckBox(PLACES[i]);
            checkBoxes[i-1].setSelected(true);
            panel.add(checkBoxes[i-1]);
        }

        int result = JOptionPane.showConfirmDialog(this, panel, "Select Delivery Locations", JOptionPane.OK_CANCEL_OPTION);
        if (result != JOptionPane.OK_OPTION) return;

        List<Integer> selected = new ArrayList<>();
        for (int i = 0; i < checkBoxes.length; i++) {
            if (checkBoxes[i].isSelected()) selected.add(i + 1);
        }

        if (selected.isEmpty()) {
            JOptionPane.showMessageDialog(this, "Please select at least one location!");
            return;
        }

        double[][] distMatrix = new double[PLACES.length][PLACES.length];
        for (int i = 0; i < PLACES.length; i++) {
            for (int j = 0; j < PLACES.length; j++) {
                distMatrix[i][j] = (i == j) ? 0 : dijkstraDistance(i, j);
            }
        }

        List<Integer> naiveRoute = new ArrayList<>();
        naiveRoute.add(DEPOT);
        naiveRoute.addAll(selected);
        naiveRoute.add(DEPOT);
        double naiveDist = calculateTotalDistance(naiveRoute, distMatrix);

        StringBuilder resultText = new StringBuilder("📊 ACO vs PSO COMPARISON\n\n");
        resultText.append(String.format("%-35s | %-12s | %-10s | %-15s | %-15s\n", 
            "Algorithm", "Distance (km)", "Time (ms)", "Saved Km", "Cost Saved (₹)"));
        resultText.append("--------------------------------------------------------------------------------------------\n");

        long start, end;

        // ACO
        start = System.nanoTime();
        List<Integer> acoRoute = runACO(selected, distMatrix);
        end = System.nanoTime();
        double acoDist = calculateTotalDistance(acoRoute, distMatrix);
        double acoTime = (end - start) / 1_000_000.0;
        double acoSaved = naiveDist - acoDist;
        double acoCostSaved = (acoSaved / KM_PER_LITER) * DIESEL_PRICE;

        resultText.append(String.format("%-35s | %-12.1f | %-10.2f | %-15.1f | %-15.0f\n", 
            "Ant Colony Optimization (ACO)", acoDist, acoTime, Math.max(0, acoSaved), Math.max(0, acoCostSaved)));

        // PSO
        start = System.nanoTime();
        List<Integer> psoRoute = runPSO(selected, distMatrix);
        end = System.nanoTime();
        double psoDist = calculateTotalDistance(psoRoute, distMatrix);
        double psoTime = (end - start) / 1_000_000.0;
        double psoSaved = naiveDist - psoDist;
        double psoCostSaved = (psoSaved / KM_PER_LITER) * DIESEL_PRICE;

        resultText.append(String.format("%-35s | %-12.1f | %-10.2f | %-15.1f | %-15.0f\n", 
            "Particle Swarm Optimization (PSO)", psoDist, psoTime, Math.max(0, psoSaved), Math.max(0, psoCostSaved)));

        outputArea.setText(resultText.toString());
    }

    // Rest of the methods (runACO, runPSO, constructAntRoute, calculateTotalDistance, dijkstraDistance, etc.) remain the same as your last version

    private List<Integer> runACO(List<Integer> deliveries, double[][] distMatrix) {
        int ants = 25;
        int iterations = 120;
        double[][] pheromone = new double[PLACES.length][PLACES.length];
        for (double[] row : pheromone) Arrays.fill(row, 1.0);

        List<Integer> bestRoute = null;
        double bestDist = Double.MAX_VALUE;

        for (int iter = 0; iter < iterations; iter++) {
            for (int ant = 0; ant < ants; ant++) {
                List<Integer> route = constructAntRoute(deliveries, distMatrix, pheromone);
                double dist = calculateTotalDistance(route, distMatrix);

                if (dist < bestDist) {
                    bestDist = dist;
                    bestRoute = new ArrayList<>(route);
                }

                for (int k = 0; k < route.size() - 1; k++) {
                    int u = route.get(k);
                    int v = route.get(k + 1);
                    pheromone[u][v] += 20.0 / dist;
                }
            }

            for (int i = 0; i < PLACES.length; i++) {
                for (int j = 0; j < PLACES.length; j++) {
                    pheromone[i][j] *= 0.65;
                }
            }
        }
        return bestRoute != null ? bestRoute : nearestNeighborTSP(deliveries, distMatrix);
    }

    private List<Integer> constructAntRoute(List<Integer> deliveries, double[][] distMatrix, double[][] pheromone) {
        boolean[] visited = new boolean[PLACES.length];
        List<Integer> route = new ArrayList<>();
        route.add(DEPOT);
        visited[DEPOT] = true;
        int current = DEPOT;

        while (route.size() < deliveries.size() + 1) {
            int next = -1;
            double maxProb = -1.0;

            for (int dest : deliveries) {
                if (!visited[dest]) {
                    double prob = pheromone[current][dest] / (distMatrix[current][dest] + 0.001);
                    if (prob > maxProb) {
                        maxProb = prob;
                        next = dest;
                    }
                }
            }
            if (next == -1) break;
            route.add(next);
            visited[next] = true;
            current = next;
        }
        route.add(DEPOT);
        return route;
    }

    private List<Integer> runPSO(List<Integer> deliveries, double[][] distMatrix) {
        int swarmSize = 30;
        int iterations = 80;
        List<List<Integer>> particles = new ArrayList<>();
        List<Integer> globalBest = null;
        double globalBestDist = Double.MAX_VALUE;

        for (int i = 0; i < swarmSize; i++) {
            List<Integer> particle = new ArrayList<>();
            particle.add(DEPOT);
            List<Integer> temp = new ArrayList<>(deliveries);
            Collections.shuffle(temp);
            particle.addAll(temp);
            particle.add(DEPOT);
            particles.add(particle);

            double dist = calculateTotalDistance(particle, distMatrix);
            if (dist < globalBestDist) {
                globalBestDist = dist;
                globalBest = new ArrayList<>(particle);
            }
        }

        for (int iter = 0; iter < iterations; iter++) {
            for (List<Integer> particle : particles) {
                if (Math.random() < 0.65) {
                    int idx1 = 1 + (int)(Math.random() * (particle.size() - 2));
                    int idx2 = 1 + (int)(Math.random() * (particle.size() - 2));
                    if (idx1 != idx2) Collections.swap(particle, idx1, idx2);
                }

                double currentDist = calculateTotalDistance(particle, distMatrix);
                if (currentDist < globalBestDist) {
                    globalBestDist = currentDist;
                    globalBest = new ArrayList<>(particle);
                }
            }
        }
        return globalBest;
    }
    private List<Integer> nearestNeighborTSP(List<Integer> deliveries, double[][] distMatrix) {
        boolean[] visited = new boolean[PLACES.length];
        List<Integer> route = new ArrayList<>();
        route.add(DEPOT);
        visited[DEPOT] = true;
        int current = DEPOT;
        while (route.size() < deliveries.size() + 1) {
            double minDist = Double.MAX_VALUE;
            int next = -1;
            for (int dest : deliveries) {
                if (!visited[dest] && distMatrix[current][dest] < minDist) {
                    minDist = distMatrix[current][dest];
                    next = dest;
                }
            }
            if (next == -1) break;
            route.add(next);
            visited[next] = true;
            current = next;
        }
        route.add(DEPOT);
        return route;
    }
    private double calculateTotalDistance(List<Integer> route, double[][] distMatrix) {
        double total = 0.0;
        for (int i = 0; i < route.size() - 1; i++) {
            total += distMatrix[route.get(i)][route.get(i + 1)];
        }
        return total;
    }
    private double dijkstraDistance(int start, int target) {
        int n = PLACES.length;
        double[] dist = new double[n];
        boolean[] done = new boolean[n];
        Arrays.fill(dist, Double.MAX_VALUE);
        dist[start] = 0;

        for (int count = 0; count < n - 1; count++) {
            int u = -1;
            double minVal = Double.MAX_VALUE;
            for (int v = 0; v < n; v++) {
                if (!done[v] && dist[v] < minVal) {
                    minVal = dist[v];
                    u = v;
                }
            }
            if (u == -1) break;
            done[u] = true;

            for (Edge e : adjList.get(u)) {
                int v = e.to;
                if (!done[v] && dist[u] + e.weight < dist[v]) {
                    dist[v] = dist[u] + e.weight;
                }
            }
        }
        return dist[target];
    }
    private void showAdjacencyList() 
    {
        StringBuilder sb = new StringBuilder("========================== ADJACENCY LIST ==========================\n\n");
        for (int i = 0; i < adjList.size(); i++) 
        {
            sb.append(String.format("%-25s → ", PLACES[i]));
            for (Edge e : adjList.get(i)) 
            {
                sb.append(PLACES[e.to]).append(" (").append(e.weight).append(" km)  ");
            }
            sb.append("\n");
        }
        outputArea.setText(sb.toString());
    }
    private void showDijkstraPanel() {
        String[] dests = new String[PLACES.length - 1];
        for (int i = 1; i < PLACES.length; i++) dests[i-1] = PLACES[i];
        String selected = (String) JOptionPane.showInputDialog(this,
                "Choose Destination:", "Dijkstra Shortest Path",
                JOptionPane.QUESTION_MESSAGE, null, dests, dests[0]);
        if (selected == null) return;
        int target = 0;
        for (int i = 1; i < PLACES.length; i++) {
            if (PLACES[i].equals(selected)) target = i;
        }

        double distance = dijkstraDistance(DEPOT, target);
        outputArea.setText("Dijkstra from " + PLACES[DEPOT] + " to " + PLACES[target] + 
                          "\nShortest Distance: " + String.format("%.1f", distance) + " km");
    }

