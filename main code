    // --- NEW: GRAPH VISUALIZATION WINDOW ---
    private void showGraphWindow() {
        JFrame graphFrame = new JFrame("Network Map");
        graphFrame.setSize(800, 800);
        graphFrame.setLocationRelativeTo(this); // Center it relative to the main window
        graphFrame.add(new GraphPanel()); // Add our custom drawing panel
        graphFrame.setVisible(true);
    }

    // --- NEW: CUSTOM DRAWING PANEL ---
    // This inner class handles all the 2D math and rendering for the visual nodes
    class GraphPanel extends JPanel {
        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            
            // Turn on anti-aliasing for smooth lines and text
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();
            int padding = 100; // Keep nodes away from the edge of the window
            int radius = Math.min(width, height) / 2 - padding;
            int centerX = width / 2;
            int centerY = height / 2;

            int n = PLACES.length;
            int[] xCoords = new int[n];
            int[] yCoords = new int[n];

            // 1. Calculate Coordinates (arrange nodes in a circle using trigonometry)
            for (int i = 0; i < n; i++) {
                // Angle in radians. Starts at top (Math.PI / 2) and goes around
                double angle = 2 * Math.PI * i / n - (Math.PI / 2);
                xCoords[i] = centerX + (int) (radius * Math.cos(angle));
                yCoords[i] = centerY + (int) (radius * Math.sin(angle));
            }

            // 2. Draw Edges (Lines and Distances)
            g2.setColor(new Color(200, 200, 200)); // Light grey for lines
            g2.setFont(new Font("Arial", Font.PLAIN, 12));
            
            for (int i = 0; i < n; i++) {
                for (Edge edge : adjList.get(i)) {
                    // Only draw if i < edge.to so we don't draw the same line twice
                    if (i < edge.to) {
                        // Draw the connecting line
                        g2.drawLine(xCoords[i], yCoords[i], xCoords[edge.to], yCoords[edge.to]);
                        
                        // Calculate the midpoint of the line to place the text
                        int midX = (xCoords[i] + xCoords[edge.to]) / 2;
                        int midY = (yCoords[i] + yCoords[edge.to]) / 2;
                        
                        // Draw the distance text with a slightly darker color so it pops out
                        g2.setColor(Color.DARK_GRAY);
                        g2.drawString(edge.weight + "km", midX, midY);
                        g2.setColor(new Color(200, 200, 200)); // Reset to grey for next line
                    }
                }
            }

            // 3. Draw Nodes (Circles and Labels)
            int nodeRadius = 15;
            for (int i = 0; i < n; i++) {
                // Make the Depot node Red, others Blue
                if (i == DEPOT) {
                    g2.setColor(new Color(220, 50, 50)); 
                } else {
                    g2.setColor(new Color(50, 100, 200));
                }
                
                // Draw the circular node
                g2.fillOval(xCoords[i] - nodeRadius, yCoords[i] - nodeRadius, nodeRadius * 2, nodeRadius * 2);

                // Draw the location name text slightly offset from the circle
                g2.setColor(Color.BLACK);
                g2.setFont(new Font("Arial", Font.BOLD, 14));
                g2.drawString(PLACES[i], xCoords[i] + nodeRadius + 5, yCoords[i] + 5);
            }
        }
    }

    // --- EXISTING ALGORITHMS & LOGIC (UNCHANGED) ---
    private void solveTSP() {
        JPanel panel = new JPanel(new GridLayout(PLACES.length - 1, 1));
        JCheckBox[] cb = new JCheckBox[PLACES.length - 1];

        for (int i = 1; i < PLACES.length; i++) {
            cb[i - 1] = new JCheckBox(PLACES[i], true);
            panel.add(cb[i - 1]);
        }

        if (JOptionPane.showConfirmDialog(this, panel, "Select Locations", JOptionPane.OK_CANCEL_OPTION) != 0) {
            return;
        }

        List<Integer> selected = new ArrayList<>();
        for (int i = 0; i < cb.length; i++) {
            if (cb[i].isSelected()) {
                selected.add(i + 1);
            }
        }
        
        if (selected.isEmpty()) return;
        double[][] dist = new double[PLACES.length][PLACES.length];
        for (int i = 0; i < PLACES.length; i++) {
            for (int j = 0; j < PLACES.length; j++) {
                dist[i][j] = (i == j) ? 0 : dijkstra(i, j);
            }
        }

        List<Integer> naiveRoute = new ArrayList<>();
        naiveRoute.add(DEPOT);
        naiveRoute.addAll(selected);
        naiveRoute.add(DEPOT);
        double naiveDist = total(naiveRoute, dist);

        StringBuilder steps = new StringBuilder();
        List<Integer> heuristicRoute = nearestNeighbor(selected, dist, steps);
        heuristicRoute = twoOpt(heuristicRoute, dist);
        double heuristicDist = total(heuristicRoute, dist);

        List<Integer> bestRoute = new ArrayList<>(naiveRoute);
        double optDist = naiveDist;
        boolean improved = false;

        if (heuristicDist < naiveDist) {
            bestRoute = new ArrayList<>(heuristicRoute);
            optDist = heuristicDist;
            improved = true;
        }

        double saved = Math.max(0, naiveDist - optDist);
        double fuel = saved / KM_PER_LITER;
        double cost = fuel * DIESEL_PRICE;

        outputArea.setText(
            "Naive Route: " + formatRoute(naiveRoute) + "\n" +
            "Naive Distance: " + formatKm(naiveDist) + " km\n\n" +
            "Optimized Route: " + formatRoute(bestRoute) + "\n" +
            "Optimized Distance: " + formatKm(optDist) + " km\n\n" +
            steps +
            "\nSaved: " + formatKm(saved) + " km\n" +
            "Fuel: " + formatKm(fuel) + " L\n" +
            "Cost: Rs. " + Math.round(cost) +
            (improved ? "\nStatus: Improved" : "\nStatus: Baseline route kept because heuristic was not better")
        );
    }

    private List<Integer> nearestNeighbor(List<Integer> deliveries, double[][] dist, StringBuilder steps) {
        boolean[] vis = new boolean[PLACES.length];
        List<Integer> route = new ArrayList<>();

        int curr = DEPOT;
        route.add(curr);
        vis[curr] = true;

        steps.append("Heuristic steps:\n");

        while (route.size() < deliveries.size() + 1) {
            double min = Double.MAX_VALUE;
            int next = -1;

            for (int d : deliveries) {
                if (!vis[d] && dist[curr][d] < min) {
                    min = dist[curr][d];
                    next = d;
                }
            }

            if (next == -1) break;

            steps.append("-> ").append(PLACES[next]).append(" (").append(formatKm(min)).append(" km)\n");
            route.add(next);
            vis[next] = true;
            curr = next;
        }

        route.add(DEPOT);
        steps.append("-> Back to Depot\n");

        return route;
    }

    private List<Integer> twoOpt(List<Integer> route, double[][] dist) {
        boolean improved = true;
        while (improved) {
            improved = false;
            for (int i = 1; i < route.size() - 2; i++) {
                for (int j = i + 1; j < route.size() - 1; j++) {
                    double curr = dist[route.get(i - 1)][route.get(i)] + dist[route.get(j)][route.get(j + 1)];
                    double newDist = dist[route.get(i - 1)][route.get(j)] + dist[route.get(i)][route.get(j + 1)];

                    if (newDist < curr) {
                        Collections.reverse(route.subList(i, j + 1));
                        improved = true;
                    }
                }
            }
        }
        return route;
    }

    private double dijkstra(int s, int t) {
        int n = PLACES.length;
        double[] dist = new double[n];
        boolean[] vis = new boolean[n];

        Arrays.fill(dist, Double.MAX_VALUE);
        dist[s] = 0;

        for (int i = 0; i < n; i++) {
            int u = -1;
            double min = Double.MAX_VALUE;

            for (int j = 0; j < n; j++) {
                if (!vis[j] && dist[j] < min) {
                    min = dist[j];
                    u = j;
                }
            }

            if (u == -1) break;
            vis[u] = true;

            for (Edge e : adjList.get(u)) {
                if (dist[u] + e.weight < dist[e.to]) {
                    dist[e.to] = dist[u] + e.weight;
                }
            }
        }
        return dist[t];
    }

    private double total(List<Integer> route, double[][] dist) {
        double sum = 0;
        for (int i = 0; i < route.size() - 1; i++) {
            sum += dist[route.get(i)][route.get(i + 1)];
        }
        return sum;
    }

    private void showAdj() {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < adjList.size(); i++) {
            sb.append(PLACES[i]).append(" -> ");
            for (Edge e : adjList.get(i)) {
                sb.append(PLACES[e.to]).append("(").append(e.weight).append(") ");
            }
            sb.append("\n");
        }
        outputArea.setText(sb.toString());
    }

    private void showDijkstra() {
        String[] opt = Arrays.copyOfRange(PLACES, 1, PLACES.length);
        String sel = (String) JOptionPane.showInputDialog(
            this, "Destination", "Dijkstra",
            JOptionPane.QUESTION_MESSAGE, null, opt, opt[0]
        );

        if (sel == null) return;

        int t = Arrays.asList(PLACES).indexOf(sel);
        outputArea.setText("Shortest distance: " + formatKm(dijkstra(DEPOT, t)) + " km");
    }

    private String formatRoute(List<Integer> route) {
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < route.size(); i++) {
            if (i > 0) sb.append(" -> ");
            sb.append(PLACES[route.get(i)]);
        }
        return sb.toString();
    }

    private String formatKm(double value) {
        return String.format(Locale.US, "%.1f", value);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new DeliveryRouteOptimizerGUI().setVisible(true));
    }
}
